data <- t(read_excel("Data_waiting-times.xls", skip = 1))
colnames(data) <- data[1,]
data<-data[-1,]
library(reshape2)
data<-melt(data)
data<-data[-57,]
colnames(data)<-c("Hospital","Date","WaitingTime")
data$WaitingTime<-as.numeric(data$WaitingTime)
#data$Date<-as.Date(weekdays(as.Date(data$Date)))
data$Date<-as.Date(data$Date)
# factor order
#levels(data$Hospital)
orders <- c("KTPH","AH","NUH(A)","NTFGH","SGH","SKH","TTSH","CGH")
#orders <- reorder (data$Hospital, data$WaitingTime)
#orders
#data$Hospital <- factor(data$Hospital, levels = rev(levels(orders)))
data$Hospital<- factor(data$Hospital, levels = rev(orders))
# Plot
ggplot(data,
aes(x=Date,
y=WaitingTime,
group=Hospital,
fill=Hospital)
) +
geom_area(alpha=0.6 , size=.3, colour="white") +
scale_fill_viridis(discrete = T) +
theme_light()+
geom_text(data,
aes(label = orders,
x = Date,
y = WaitingTime,
color = orders),
position = position_stack(vjust = 0.5))+
xlab("Date") +
ylab("Median Wait Time for Admission at ED (Hr)")+
ggtitle("Statistics of wait time for admission to ward\n (Sun 25 - Sat 31 Oct 2020)")
library(readxl)
data <- t(read_excel("Data_waiting-times.xls", skip = 1))
colnames(data) <- data[1,]
data<-data[-1,]
library(reshape2)
data<-melt(data)
colnames(data)<-c("Hospital","Date","WaitingTime")
data["Waiting Time (hrs)", ]<-as.numeric(data["Waiting Time (hrs)", ])
data<-data[-57,]
library(ggplot2)
library(ggiraph)
library(ggridges)
gg_ridge <- ggplot(data=data, aes(x = Date, y = Hospital))+
geom_density_ridges_gradient(rel_min_height = 0.01)
gg_ridge
ggplot(data,aes(y=Date, x=as.numeric(WaitingTime))) +
geom_density_ridges_gradient(scale = 3, rel_min_height = 0.01) +
theme_ridges() +
theme(
legend.position="none",
panel.spacing = unit(0.1, "lines"),
strip.text.x = element_text(size = 8)
) +
xlab("Waiting Time") +
ylab("Date")
# Library
library(viridis)
library(hrbrthemes)
# Plot
ggplot(data,aes(x=Date, y=as.numeric(WaitingTime)), fill=Hospital) +
geom_area(alpha=0.6 , size=.5, colour="white") +
scale_fill_viridis(discrete = T) +
theme_ipsum() +
ggtitle("The race between ...")
