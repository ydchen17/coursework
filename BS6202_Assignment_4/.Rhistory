```{r}
colnames(DMD_Pescatori)
colnames(DMD_Pescatori[1:22])
colnames(DMD_Pescatori[23:36])
```
```{r}
DMD_Pescatori <- read.csv("DMD-PescatoriData.csv")
rownames(DMD_Pescatori)<-c(DMD_Pescatori[,1])
DMD_Pescatori[,1:2]<-NULL
DMD <- DMD_Pescatori[,1:22]
NOR <- DMD_Pescatori[,23:36]
DMD_Pescatori_DEG <- NULL
for (row in 1:nrow(DMD_Pescatori)){
ttest <- t.test(t(DMD[row,]), t(NOR[row,]))
pvalue <- p.adjust(ttest$p.value, method = "fdr", n = nrow(DMD_Pescatori))
if (pvalue <0.05){
if (mean(t(DMD[row,]) > mean(t(NOR[row,])))){
DEG <- cbind(rownames(DMD_Pescatori[row,]), pvalue,"+")
}else{
DEG <- cbind(rownames(DMD_Pescatori[row,]), pvalue,"-")
}
DMD_Pescatori_DEG <- rbind(DMD_Pescatori_DEG, DEG)
}
}
nrow(DMD_Pescatori_DEG)
write.csv(as.data.frame(DMD_Pescatori_DEG), file="DMD_Pescatori_DEG.csv")
```
